new file mode 100644
index 0000000..967c5e7
--- /dev/null
+++ b/src/crawl_log.rs
@@ -0,0 +1,90 @@
+//! Measurement hook for the PQ-Discovery study (RQ2/RQ3).
+//!
+//! Records every ENR as it arrives in a NODES response, before discv5 filters or
+//! deduplicates it. This is deliberately not built on the public `Event::Discovered`
+//! stream, for two reasons found in `service.rs`:
+//!
+//!   * the event channel is bounded at 100 and `send_event` only handles `Closed`,
+//!     so a brief consumer stall drops events silently — and it would drop them
+//!     during traffic bursts, which is exactly when repeats are most likely;
+//!   * `Event::Discovered(Enr)` carries only the ENR, losing the `source` node and
+//!     `query_id` that `discovered()` has in hand. Both are needed: source to
+//!     attribute records to the peer that served them, query_id to group records
+//!     into lookups.
+//!
+//! Writing straight from `discovered()` avoids both. Enabled only when
+//! DISCV5_CRAWL_LOG names an output path, so an unset variable leaves upstream
+//! behaviour untouched.
+
+use std::collections::HashSet;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+use std::sync::{Mutex, OnceLock};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+static LOG: OnceLock<Option<Mutex<BufWriter<File>>>> = OnceLock::new();
+
+/// Distinct records, written once per (node_id, seq). RQ1's field decomposition
+/// needs the record itself, not just its length, but writing every observation
+/// would be ~24 MB on Ethereum for no extra information.
+static ENRS: OnceLock<Option<Mutex<(BufWriter<File>, HashSet<String>)>>> = OnceLock::new();
+
+fn sink() -> Option<&'static Mutex<BufWriter<File>>> {
+    LOG.get_or_init(|| {
+        let path = std::env::var("DISCV5_CRAWL_LOG").ok()?;
+        let f = File::create(&path).ok()?;
+        let mut w = BufWriter::new(f);
+        let _ = writeln!(w, "ts_ms,query_id,source,node_id,seq,size");
+        Some(Mutex::new(w))
+    })
+    .as_ref()
+}
+
+fn enr_sink() -> Option<&'static Mutex<(BufWriter<File>, HashSet<String>)>> {
+    ENRS.get_or_init(|| {
+        let path = std::env::var("DISCV5_CRAWL_ENRS").ok()?;
+        let f = File::create(&path).ok()?;
+        Some(Mutex::new((BufWriter::new(f), HashSet::new())))
+    })
+    .as_ref()
+}
+
+/// Record the base64 ENR itself, once per distinct (node_id, seq).
+pub(crate) fn record_enr(node_id: &str, seq: u64, base64: &str) {
+    let Some(lock) = enr_sink() else { return };
+    if let Ok(mut g) = lock.lock() {
+        let key = format!("{node_id}:{seq}");
+        if g.1.insert(key) {
+            let _ = writeln!(g.0, "{base64}");
+        }
+    }
+}
+
+/// One observation: this ENR arrived from `source`, during `query_id`, at this instant.
+///
+/// `size` is the RLP-encoded length, i.e. the figure the EIP-778 300-byte cap applies to.
+pub(crate) fn record(source: &str, query_id: Option<usize>, node_id: &str, seq: u64, size: usize) {
+    let Some(lock) = sink() else { return };
+    let ts = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0);
+    if let Ok(mut w) = lock.lock() {
+        let q = query_id.map_or_else(|| "-".to_string(), |q| q.to_string());
+        let _ = writeln!(w, "{ts},{q},{source},{node_id},{seq},{size}");
+    }
+}
+
+/// Flush before exit; a buffered tail would otherwise be lost.
+pub fn flush() {
+    if let Some(lock) = sink() {
+        if let Ok(mut w) = lock.lock() {
+            let _ = w.flush();
+        }
+    }
+    if let Some(lock) = enr_sink() {
+        if let Ok(mut g) = lock.lock() {
+            let _ = g.0.flush();
+        }
+    }
+}
